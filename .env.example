# ==============================================================================
# StaffSync - Production & Local Environment Configuration
# ==============================================================================

# Backend Server Configuration (Express)
PORT=5000
NODE_ENV=production

# MongoDB Database URI (MongoDB Atlas or Local MongoDB)
# Leave empty for zero-config in-memory fallback during local testing/evaluation
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/staffsync?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=staffsync_enterprise_jwt_secure_secret_key_2026_xyz
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL in production)
CLIENT_URL=https://staffsync-mern-hrms.vercel.app

# Organization Defaults
TIMEZONE=America/New_York
ORG_NAME=StaffSync Inc.

# Frontend Client Configuration (.env for client/ if deploying separately)
VITE_API_URL=https://staffsync-server.onrender.com
